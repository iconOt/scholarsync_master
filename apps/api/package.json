    "jsonwebtoken": "^9.0.0",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/pdfkit": "^0.12.2",
    "@types/pg": "^8.6.6",
    "dotenv-cli": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.123.0"
